.npm/
**/.npm/
**/.pnpm-store/

# Integration files mounted into the test container
tests/integration/*/
!tests/integration/fixtures/

# .NET build output
bin/
obj/
**/bin/
**/obj/
*.user
*.suo
*.userprefs
