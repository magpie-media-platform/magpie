# CDN deployment - UI hosted separately from API (e.g., Cloudflare Pages, Netlify, S3)
# The API host must list this UI origin in Magpie:AllowedOrigins to answer its browser requests
# Replace with the actual API URL before building
VITE_API_URL=https://api.example.com/api

# Base path for assets - use '/' for root, '/magpie/' for subdirectory deployment
# VITE_BASE_URL=/
