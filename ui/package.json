{
    "name": "magpie-ui",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
        "build:embedded": "tsc -b tsconfig.app.json tsconfig.node.json && vite build --mode production",
        "build:cdn": "tsc -b tsconfig.app.json tsconfig.node.json && vite build --mode cdn",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
        "lint": "pnpm run lint:eslint && pnpm run lint:css && pnpm run lint:duplication",
        "lint:css": "stylelint \"src/**/*.css\"",
        "lint:duplication": "jscpd src --format css --min-lines 12 --min-tokens 80 --threshold 2.5 --reporters threshold --no-colors --no-tips",
        "lint:eslint": "eslint . --max-warnings 0",
        "typecheck": "tsc -b",
        "preview": "vite preview",
        "test": "vitest run",
        "test:all": "vitest run",
        "verify:item": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
        "verify-full": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm run test:all",
        "test:watch": "vitest",
        "test:report": "vitest run --reporter=verbose",
        "test:report:all": "vitest run --reporter=verbose",
        "test:report:watch": "vitest --reporter=verbose",
        "test:a11y": "vitest run src/test/a11y.test.tsx",
        "codegen": "pnpm run build:grammar",
        "build:grammar": "lezer-generator src/editor/filter-query.grammar --typeScript -o src/editor/filter-query-parser.gen.ts"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.0",
        "@codemirror/commands": "^6.10.2",
        "@codemirror/language": "^6.12.1",
        "@codemirror/lint": "^6.9.3",
        "@codemirror/state": "^6.5.4",
        "@codemirror/view": "^6.39.13",
        "@lezer/highlight": "^1.2.3",
        "@lezer/lr": "^1.4.8",
        "@phosphor-icons/react": "^2.1.7",
        "@radix-ui/react-checkbox": "^1.1.3",
        "@radix-ui/react-collapsible": "^1.1.2",
        "@radix-ui/react-dialog": "^1.1.4",
        "@radix-ui/react-dropdown-menu": "^2.1.4",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-popover": "^1.1.6",
        "@radix-ui/react-select": "^2.1.4",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-switch": "^1.1.2",
        "@radix-ui/react-tabs": "^1.1.2",
        "@radix-ui/react-toast": "^1.2.15",
        "@radix-ui/react-tooltip": "^1.1.6",
        "@tanstack/react-query": "^5.90.20",
        "@tanstack/react-table": "^8.21.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@lezer/generator": "^1.8.0",
        "@tanstack/eslint-plugin-query": "^5.101.2",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@types/node": "^25.0.10",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^6.0.3",
        "axe-core": "^4.11.1",
        "eslint": "^9.18.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.0.2",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.1.0",
        "globals": "^15.14.0",
        "jscpd": "^5.0.12",
        "jsdom": "^26.0.0",
        "prettier": "^3.8.1",
        "stylelint": "^17.14.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "npm:@typescript/typescript6@~6.0.2",
        "typescript-eslint": "^8.63.0",
        "vite": "^8.1.4",
        "vitest": "^4.1.10",
        "vitest-axe": "^0.1.0"
    }
}
