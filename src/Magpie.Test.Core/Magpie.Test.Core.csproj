<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)..\test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="RichardSzalay.MockHttp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Magpie.Api\Magpie.Api.csproj" />
    <ProjectReference Include="..\Magpie.App\Magpie.App.csproj" />
    <ProjectReference Include="..\Magpie.Core\Magpie.Core.csproj" />
    <ProjectReference Include="..\Magpie.CommandLine.Generators\Magpie.CommandLine.Generators.csproj" />
    <ProjectReference Include="..\Magpie.Data.SQLite\Magpie.Data.SQLite.csproj" />
    <ProjectReference Include="..\Magpie.Extensions.MediaInfo.FFProbe\Magpie.Extensions.MediaInfo.FFProbe.csproj" />
    <ProjectReference Include="..\Magpie.Extensions.Cardigann\Magpie.Extensions.Cardigann.csproj" />
    <ProjectReference Include="..\Magpie.Extensions.Tvmaze\Magpie.Extensions.Tvmaze.csproj" />
    <ProjectReference Include="..\Magpie.Extensions.Tv\Magpie.Extensions.Tv.csproj" />
  </ItemGroup>

</Project>
