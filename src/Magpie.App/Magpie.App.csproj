<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeSpa Condition="'$(IncludeSpa)' == ''">true</IncludeSpa>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Magpie.Api\Magpie.Api.csproj" />
    <ProjectReference Include="..\Magpie.Auth\Magpie.Auth.csproj" />
    <ProjectReference Include="..\Magpie.CommandLine\Magpie.CommandLine.csproj" />
    <ProjectReference Include="..\Magpie.Core\Magpie.Core.csproj" />
    <ProjectReference Include="..\Magpie.Data.SQLite\Magpie.Data.SQLite.csproj" />
    <ProjectReference Include="..\Magpie.Data.PostgreSQL\Magpie.Data.PostgreSQL.csproj" />
    <ProjectReference Include="..\Magpie.Data.SqlServer\Magpie.Data.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeSpa)' == 'true'">
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IncludeSpa)' == 'true'">
    <SpaRoot>$(MSBuildThisFileDirectory)..\..\ui\</SpaRoot>
    <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>pnpm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>

  <Target Name="PublishSpa" AfterTargets="ComputeFilesToPublish" Condition="'$(IncludeSpa)' == 'true'">
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(SpaRoot)" />
    <Exec Command="pnpm run build:embedded" WorkingDirectory="$(SpaRoot)" />

    <ItemGroup>
      <_SpaDistFiles Include="$(SpaRoot)dist\**" />
      <ResolvedFileToPublish Include="@(_SpaDistFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="RemoveIntegrationTestShimsPublishOutput" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)extensions\integrationtestshims" />
  </Target>

</Project>
