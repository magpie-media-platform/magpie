<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- Plugins are loaded at runtime via Assembly.LoadFromAssemblyPath. They are not
         a project reference of Magpie.App, so consumers copy the build output into
         the configured extensions directory. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Magpie.Abstractions\Magpie.Abstractions.csproj" />
    <ProjectReference Include="..\Magpie.Models\Magpie.Models.csproj" />
  </ItemGroup>

</Project>
