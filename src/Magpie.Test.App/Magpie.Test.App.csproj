<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)..\test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Magpie.Abstractions\Magpie.Abstractions.csproj" />
    <ProjectReference Include="..\Magpie.App\Magpie.App.csproj" />
    <ProjectReference Include="..\Magpie.Models\Magpie.Models.csproj" />
    <ProjectReference Include="..\Magpie.Test.Shared\Magpie.Test.Shared.csproj" />
    <!-- The SampleIndexer is referenced for build order only. We deliberately do NOT
         bring its assembly into the test AppDomain: AssemblyLoadContext.Default returns
         an already-loaded assembly when identity matches, which would prevent the loader
         tests from exercising the on-disk LoadFromAssemblyPath code path. The DLL is
         copied into TestExtensions/sample/ by the StageSampleExtension target below. -->
    <ProjectReference Include="..\Magpie.Extensions.SampleIndexer\Magpie.Extensions.SampleIndexer.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <Target Name="StageSampleExtension"
          AfterTargets="Build"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileDirectory)..\Magpie.Extensions.SampleIndexer\bin\$(Configuration)\netstandard2.1\Magpie.Extensions.SampleIndexer.dll"
          Outputs="$(OutputPath)TestExtensions\sample\Magpie.Extensions.SampleIndexer.dll">
    <PropertyGroup>
      <_SampleSourceDir>$(MSBuildThisFileDirectory)..\Magpie.Extensions.SampleIndexer\bin\$(Configuration)\netstandard2.1\</_SampleSourceDir>
      <_SampleStageDir>$(OutputPath)TestExtensions\sample\</_SampleStageDir>
    </PropertyGroup>
    <ItemGroup>
      <_SampleStagedFiles Include="$(_SampleSourceDir)Magpie.Extensions.SampleIndexer.dll" />
      <_SampleStagedFiles Include="$(_SampleSourceDir)Magpie.Extensions.SampleIndexer.pdb"
                          Condition="Exists('$(_SampleSourceDir)Magpie.Extensions.SampleIndexer.pdb')" />
    </ItemGroup>
    <MakeDir Directories="$(_SampleStageDir)" />
    <Copy SourceFiles="@(_SampleStagedFiles)"
          DestinationFolder="$(_SampleStageDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
