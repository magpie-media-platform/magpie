{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["specs/**/*.ts", "helpers/**/*.ts", "playwright.config.ts", "live-updates/**/*.ts", "live-updates.config.ts", "content-filters/**/*.ts", "content-filters.config.ts", "auth-renewal/**/*.ts", "auth-renewal.config.ts"]
}
