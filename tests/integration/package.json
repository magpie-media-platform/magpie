{
  "name": "magpie-integration-tests",
  "private": true,
  "version": "0.0.0",
  "description": "End-to-end integration suite that drives the Magpie host in a Docker container via Playwright, with mock integrations driven by on-disk JSON scenarios.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build-image": "docker compose build",
    "up": "docker compose up -d --wait",
    "down": "node scripts/reset.mjs",
    "test": "node scripts/suite.mjs",
    "test:running": "docker compose --profile test run --rm tests",
    "test:host": "playwright test",
    "logs": "docker compose logs -f magpie",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "^20.14.0",
    "typescript": "^7.0.2"
  }
}
